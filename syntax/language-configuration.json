{
    "comments": {
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["```", "```"],
        ["c'", "'"],
        ["/*", "*/"]
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["```", "```"],
        ["c'", "'"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(function|if|else|for|while|typedef|trait|struct|union|enum|defer|implement|rule|rules|specialise|extend|type|abstract)\\b.*\\{$",
        "decreaseIndentPattern": "^\\s*\\}"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(function|if|else|for|while|typedef|trait|struct|union|enum|defer|implement|rule|rules|specialise|extend|type|abstract)\\b.*\\{$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*\\{",
            "action": { "indent": "indent" }
        }
    ]
}
